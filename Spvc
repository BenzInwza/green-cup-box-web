
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Green Cup Box | ลดโลกร้อน</title>
  <meta name="theme-color" content="#16834a">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f3f9f2;
      color: #193b2a;
    }
    header {
      background: #16834a;
      color: white;
      padding: 24px 18px;
      border-radius: 0 0 26px 26px;
    }
    .brand { font-size: 23px; font-weight: 800; }
    header p { line-height: 1.7; }
    main { max-width: 760px; margin: auto; padding: 18px; }
    .hero, .panel {
      background: white;
      padding: 20px;
      border-radius: 18px;
      margin-bottom: 16px;
      box-shadow: 0 3px 14px #153e2410;
    }
    h2 { margin-top: 0; }
    .points {
      background: #e2f5df;
      border-radius: 14px;
      padding: 16px;
      margin: 16px 0;
    }
    button {
      background: #16834a;
      color: white;
      border: 0;
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 16px;
      cursor: pointer;
    }
    .reward {
      padding: 13px 0;
      border-bottom: 1px solid #e5eee5;
      overflow-wrap: anywhere;
    }
    .muted { color: #587061; font-size: 14px; }
    footer { text-align: center; padding: 22px; color: #587061; }
  </style>
</head>
<body>
  <header>
    <div class="brand">🌱 Green Cup Box</div>
    <p>ลดโลกร้อน เริ่มต้นง่าย ๆ ด้วยการพกแก้วและกล่องส่วนตัว</p>
    <button onclick="document.getElementById('rewards').scrollIntoView({behavior:'smooth'})">
      ดูของรางวัล ♻️
    </button>
  </header>

  <main>
    <section class="hero">
      <h2>รักษ์โลกได้ทุกวัน</h2>
      <p>พกแก้ว พกกล่อง ลดขยะ และร่วมสร้างโลกที่น่าอยู่ไปด้วยกัน</p>
      <div class="points">
        <strong>🌿 คะแนนสะสมของคุณ</strong>
        <p>ระบบคะแนนจะแสดงเมื่อเข้าสู่ระบบสมาชิก</p>
      </div>
      
<div class="panel" id="member-panel">
  <h2>👤 สมาชิก Green Cup Box</h2>
  <p class="muted">สมัครสมาชิกหรือเข้าสู่ระบบด้วยอีเมล</p>

  <label for="member-email">อีเมล</label>
  <input id="member-email" type="email"
    placeholder="กรอกอีเมล"
    autocomplete="email"
    style="display:block;width:100%;padding:12px;margin:8px 0 14px">

  <label for="member-password">รหัสผ่าน</label>
  <input id="member-password" type="password"
    placeholder="กรอกรหัสผ่าน"
    autocomplete="current-password"
    style="display:block;width:100%;padding:12px;margin:8px 0 14px">

  <button type="button" id="signup-btn">สมัครสมาชิก</button>
  <button type="button" id="login-btn">เข้าสู่ระบบ</button>
  <button type="button" id="logout-btn" hidden>ออกจากระบบ</button>

  <p id="member-status" role="status" aria-live="polite"></p>
</div>

    </section>

    <section class="panel" id="rewards">
      <h2>🎁 ของรางวัลของเรา</h2>
      <p class="muted" id="status">กำลังเตรียมรายการของรางวัล...</p>
      <div id="reward-list"></div>
    </section>
  </main>

  <footer>Green Cup Box · โลกสีเขียวเริ่มที่เรา 🌎</footer>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://sjlmwicteshsabzlkvab.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_tqvsVPcYKq-QC6LtA3oVeg_NsR7wchz";

    async function loadRewards() {
      const status = document.getElementById("status");
      const list = document.getElementById("reward-list");

      if (
        SUPABASE_URL === "ใส่_PROJECT_URL" ||
        SUPABASE_ANON_KEY === "ใส่_PUBLISHABLE_KEY"
      ) {
        status.textContent =
          "หน้าเว็บพร้อมแล้ว รอเชื่อมต่อ Supabase";
        return;
      }

      try {
        const db = window.supabase.createClient(
          SUPABASE_URL, SUPABASE_ANON_KEY
        );

        const { data, error } = await db
          .from("rewards")
          .select("*");

        if (error) throw error;

        list.replaceChildren();

        if (!data || data.length === 0) {
          status.textContent = "ยังไม่มีรายการของรางวัล";
          return;
        }

        data.forEach((reward) => {
          const item = document.createElement("div");
          item.className = "reward";
          const name =
            reward.name ?? reward.title ?? "ของรางวัล";
          const detail = Object.entries(reward)
            .filter(([key]) => key !== "name" && key !== "title")
            .map(([key, value]) => `${key}: ${
              typeof value === "object"
                ? JSON.stringify(value)
                : String(value ?? "-")
            }`)
            .join(" · ");

          const heading = document.createElement("strong");
          heading.textContent = "🎁 " + name;
          item.appendChild(heading);

          if (detail) {
            const info = document.createElement("p");
            info.className = "muted";
            info.textContent = detail;
            item.appendChild(info);
          }

          list.appendChild(item);
        });

        status.textContent =
          `พบของรางวัล ${data.length} รายการ`;
      } catch (error) {
        status.textContent =
          "เชื่อมต่อไม่สำเร็จ: " + error.message;
      }
    }

    loadRewards();
 </script>
  
<script>
  const memberDb = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY
  );

  const memberStatus = document.getElementById("member-status");
  const signupBtn = document.getElementById("signup-btn");
  const loginBtn = document.getElementById("login-btn");
  const logoutBtn = document.getElementById("logout-btn");

  function showMember(message, loggedIn) {
    memberStatus.textContent = message;
    signupBtn.hidden = loggedIn;
    loginBtn.hidden = loggedIn;
    logoutBtn.hidden = !loggedIn;
  }

  signupBtn.addEventListener("click", async () => {
    const email = document.getElementById("member-email").value.trim();
    const password = document.getElementById("member-password").value;

    if (!email || !password) {
      memberStatus.textContent = "กรุณากรอกอีเมลและรหัสผ่าน";
      return;
    }

    memberStatus.textContent = "กำลังสมัครสมาชิก...";

    const { data, error } = await memberDb.auth.signUp({
      email,
      password
    });

    if (error) {
      memberStatus.textContent = "สมัครไม่สำเร็จ: " + error.message;
      return;
    }

    if (data.session) {
      showMember("สมัครสมาชิกสำเร็จ 🎉", true);
    } else {
      memberStatus.textContent =
        "ส่งคำขอสมัครแล้ว กรุณาตรวจอีเมลเพื่อยืนยันบัญชี";
    }
  });

  loginBtn.addEventListener("click", async () => {
    const email = document.getElementById("member-email").value.trim();
    const password = document.getElementById("member-password").value;

    if (!email || !password) {
      memberStatus.textContent = "กรุณากรอกอีเมลและรหัสผ่าน";
      return;
    }

    memberStatus.textContent = "กำลังเข้าสู่ระบบ...";

    const { data, error } = await memberDb.auth.signInWithPassword({
      email,
      password
    });

    if (error) {
      memberStatus.textContent = "เข้าสู่ระบบไม่สำเร็จ: " + error.message;
      return;
    }

    showMember("เข้าสู่ระบบสำเร็จ 🎉", true);
  });

  logoutBtn.addEventListener("click", async () => {
    const { error } = await memberDb.auth.signOut();

    if (error) {
      memberStatus.textContent = "ออกจากระบบไม่สำเร็จ";
      return;
    }

    showMember("ออกจากระบบแล้ว", false);
  });

  memberDb.auth.getSession().then(({ data, error }) => {
    if (error) {
      memberStatus.textContent = "ตรวจสอบสมาชิกไม่สำเร็จ";
      return;
    }

    if (data.session) {
      showMember("เข้าสู่ระบบอยู่แล้ว 🎉", true);
    }
  });
</script>
</body>
</html>

