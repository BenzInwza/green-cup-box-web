
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Green Cup Box | ลดโลกร้อน</title>
  <meta name="theme-color" content="#16834a">

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f3f9f2;
      color: #193b2a;
    }

    header {
      background: #16834a;
      color: white;
      padding: 20px 18px;
      border-radius: 0 0 26px 26px;
      position: relative;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .brand { font-size: 23px; font-weight: 800; }
    header p { line-height: 1.7; }
    main { max-width: 760px; margin: auto; padding: 18px; }

    .hero, .panel {
      background: white;
      padding: 20px;
      border-radius: 18px;
      margin-bottom: 16px;
      box-shadow: 0 3px 14px #153e2410;
    }

    h2 { margin-top: 0; }

    .points {
      background: #e2f5df;
      border-radius: 14px;
      padding: 16px;
      margin: 16px 0;
    }

    button {
      background: #16834a;
      color: white;
      border: 0;
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 16px;
      cursor: pointer;
      margin: 3px;
    }

    button:disabled {
      background: #a6b5aa;
      cursor: not-allowed;
    }

    .menu-button {
      background: white;
      color: #16834a;
      font-size: 25px;
      width: 48px;
      height: 46px;
      padding: 4px;
      margin: 0;
    }

    .menu-panel {
      background: white;
      color: #193b2a;
      border-radius: 16px;
      padding: 15px;
      margin-top: 14px;
      box-shadow: 0 4px 14px #103c2020;
    }

    .menu-panel button { width: 100%; margin: 5px 0; }
    .logout-button { background: #c62828; }

    .reward {
      padding: 16px 0;
      border-bottom: 1px solid #e5eee5;
      overflow-wrap: anywhere;
    }

    .reward-name { font-size: 17px; }

    .reward-detail {
      background: #f3f9f2;
      padding: 10px;
      border-radius: 10px;
      margin: 8px 0;
    }

    .muted { color: #587061; font-size: 14px; }
    .status { white-space: pre-wrap; }
    footer { text-align: center; padding: 22px; color: #587061; }

    input {
      border: 1px solid #cbd9cd;
      border-radius: 10px;
      font-size: 16px;
    }

    [hidden] { display: none !important; }
  </style>
</head>

<body>
  <header>
    <div class="topbar">
      <div class="brand">🌱 Green Cup Box</div>

      <button type="button" id="menu-btn"
        class="menu-button" aria-label="เปิดเมนู"
        aria-expanded="false" aria-controls="menu-panel" hidden>
        ☰
      </button>
    </div>

    <p>ลดโลกร้อน เริ่มต้นง่าย ๆ ด้วยการพกแก้วและกล่องส่วนตัว</p>

    <button type="button" id="view-rewards-btn">
      ดูของรางวัล ♻️
    </button>

    <div id="menu-panel" class="menu-panel" hidden>
      <strong>👤 บัญชีสมาชิก</strong>
      <p id="menu-email" class="muted"></p>

      <button type="button" id="menu-points-btn">
        🌿 ดูคะแนนของฉัน
      </button>

      <button type="button" id="logout-btn" class="logout-button">
        ↪ ออกจากระบบ
      </button>

      <p id="menu-status" class="status"
        role="status" aria-live="polite"></p>
    </div>
  </header>

  <main>
    <section class="hero">
      <h2>รักษ์โลกได้ทุกวัน</h2>
      <p>พกแก้ว พกกล่อง ลดขยะ และร่วมสร้างโลกที่น่าอยู่ไปด้วยกัน</p>

      <div class="points" id="points-box">
        <strong>🌿 คะแนนสะสมของคุณ</strong>
        <p id="points-display">กรุณาเข้าสู่ระบบเพื่อดูคะแนน</p>
      </div>

      <div class="panel" id="member-panel">
        <h2>👤 สมาชิก Green Cup Box</h2>
        <p class="muted">สมัครสมาชิกหรือเข้าสู่ระบบด้วยอีเมล</p>

        <div id="member-fields">
          <label for="member-email">อีเมล</label>
          <input id="member-email" type="email"
            placeholder="กรอกอีเมล" autocomplete="email"
            style="display:block;width:100%;padding:12px;margin:8px 0 14px">

          <label for="member-password">รหัสผ่าน</label>
          <input id="member-password" type="password"
            placeholder="กรอกรหัสผ่าน" autocomplete="current-password"
            style="display:block;width:100%;padding:12px;margin:8px 0 14px">
        </div>

        <button type="button" id="signup-btn">สมัครสมาชิก</button>
        <button type="button" id="login-btn">เข้าสู่ระบบ</button>

        <p id="member-status" class="status"
          role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="panel" id="rewards">
      <h2>🎁 ของรางวัลของเรา</h2>
      <p class="muted" id="status" role="status" aria-live="polite">
        กำลังเตรียมรายการของรางวัล...
      </p>
      <div id="reward-list"></div>
    </section>
  </main>

  <footer>Green Cup Box · โลกสีเขียวเริ่มที่เรา 🌎</footer>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    const SUPABASE_URL =
      "https://sjlmwicteshsabzlkvab.supabase.co";

    const SUPABASE_ANON_KEY =
      "sb_publishable_tqvsVPcYKq-QC6LtA3oVeg_NsR7wchz";

    const db = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );

    const $ = id => document.getElementById(id);

    const memberStatus = $("member-status");
    const menuStatus = $("menu-status");
    const memberPanel = $("member-panel");
    const signupBtn = $("signup-btn");
    const loginBtn = $("login-btn");
    const logoutBtn = $("logout-btn");
    const emailInput = $("member-email");
    const passwordInput = $("member-password");
    const pointsDisplay = $("points-display");
    const menuBtn = $("menu-btn");
    const menuPanel = $("menu-panel");

    let currentUserId = null;
    let rewardsLoading = false;
    let pointsRequest = 0;

    function closeMenu() {
      menuPanel.hidden = true;
      menuBtn.setAttribute("aria-expanded", "false");
    }

    function showMember(message, user = null) {
      const loggedIn = !!user;
      currentUserId = loggedIn ? user.id : null;

      memberStatus.textContent = message;
      memberPanel.hidden = loggedIn;
      menuBtn.hidden = !loggedIn;

      if (loggedIn) {
        $("menu-email").textContent =
          user.email || "สมาชิก Green Cup Box";
      } else {
        closeMenu();
        $("menu-email").textContent = "";
        menuStatus.textContent = "";
        pointsRequest++;
        pointsDisplay.textContent =
          "กรุณาเข้าสู่ระบบเพื่อดูคะแนน";
      }
    }

    $("view-rewards-btn").addEventListener("click", () => {
      $("rewards").scrollIntoView({ behavior: "smooth" });
    });

    menuBtn.addEventListener("click", () => {
      const opening = menuPanel.hidden;
      menuPanel.hidden = !opening;
      menuBtn.setAttribute("aria-expanded", String(opening));
    });

    $("menu-points-btn").addEventListener("click", () => {
      closeMenu();
      $("points-box").scrollIntoView({ behavior: "smooth" });
    });

    async function loadMemberPoints(userId) {
      const requestId = ++pointsRequest;
      pointsDisplay.textContent = "กำลังโหลดคะแนน...";

      try {
        const { data, error } = await db
          .from("point_transactions")
          .select("delta")
          .eq("user_id", userId);

        if (
          requestId !== pointsRequest ||
          currentUserId !== userId
        ) return;

        if (error) throw error;

        let total = 0;

        for (const row of (data || [])) {
          const amount = Number(row.delta);

          if (!Number.isFinite(amount)) {
            throw new Error("ข้อมูลคะแนนไม่ถูกต้อง");
          }

          total += amount;
        }

        pointsDisplay.textContent = `คะแนนสะสม ${total} แต้ม`;
      } catch (error) {
        if (
          requestId === pointsRequest &&
          currentUserId === userId
        ) {
          pointsDisplay.textContent =
            "อ่านคะแนนไม่ได้: " + error.message;
        }
      }
    }

    async function loadRewards() {
      if (rewardsLoading) return;

      rewardsLoading = true;

      const status = $("status");
      const list = $("reward-list");

      status.textContent = "กำลังโหลดของรางวัล...";
      
      try {
        const { data, error } = await db
          .from("rewards")
          .select("*")
          .order("id", { ascending: true });

        if (error) throw error;

        list.replaceChildren();

        if (!data || data.length === 0) {
          status.textContent = "ยังไม่มีรายการของรางวัล";
          return;
        }

        for (const reward of data) {
          const item = document.createElement("div");
          item.className = "reward";

          const heading = document.createElement("strong");
          heading.className = "reward-name";
          heading.textContent =
            `${reward.icon || "🎁"} ${
              reward.name ?? reward.title ?? "ของรางวัล"
            }`;

          item.appendChild(heading);

          const detail = document.createElement("div");
          detail.className = "reward-detail muted";

          const cost = Number(reward.cost);
          const validCost =
            reward.cost !== null &&
            reward.cost !== undefined &&
            Number.isFinite(cost) &&
            cost >= 0;

          detail.textContent =
            `ใช้ ${validCost ? cost : "ไม่ระบุ"} แต้ม` +
            (reward.stock !== null &&
             reward.stock !== undefined
              ? ` · คงเหลือ ${reward.stock} ชิ้น`
              : "");

          item.appendChild(detail);

          const redeemBtn = document.createElement("button");
          redeemBtn.type = "button";
          redeemBtn.textContent = "🎁 แลกของรางวัล";

          const stock = Number(reward.stock);
          const outOfStock =
            reward.stock !== null &&
            reward.stock !== undefined &&
            Number.isFinite(stock) &&
            stock <= 0;

          if (outOfStock) {
            redeemBtn.disabled = true;
            redeemBtn.textContent = "สินค้าหมด";
          } else if (!validCost) {
            redeemBtn.disabled = true;
            redeemBtn.textContent = "ข้อมูลคะแนนไม่ถูกต้อง";
          } else {
            redeemBtn.addEventListener("click", () => {
              redeemReward(reward.id, redeemBtn);
            });
          }

          item.appendChild(redeemBtn);
          list.appendChild(item);
        }

        status.textContent = `พบของรางวัล ${data.length} รายการ`;
      } catch (error) {
        status.textContent =
          "โหลดของรางวัลไม่สำเร็จ: " + error.message;
      } finally {
        rewardsLoading = false;
      }
    }

    async function redeemReward(rewardId, button) {
      const userId = currentUserId;

      if (!userId) {
        alert("กรุณาเข้าสู่ระบบก่อนแลกของรางวัล");
        return;
      }

      if (!confirm("ยืนยันการแลกของรางวัลนี้หรือไม่?")) {
        return;
      }

      button.disabled = true;
      button.textContent = "กำลังแลก...";

      try {
        // ป้องกันการใช้ session เก่าหลังเปลี่ยนบัญชี
        const { data: sessionData, error: sessionError } =
          await db.auth.getSession();

        if (sessionError) throw sessionError;

        if (
          !sessionData.session ||
          sessionData.session.user.id !== userId ||
          currentUserId !== userId
        ) {
          throw new Error(
            "เซสชันสมาชิกเปลี่ยนไป กรุณาเข้าสู่ระบบใหม่"
          );
        }

        // เรียกฟังก์ชัน Supabase ที่สร้างไว้
        const { data, error } = await db.rpc(
          "redeem_reward",
          { p_reward_id: rewardId }
        );

        if (error) throw error;

        // ฟังก์ชันเดิมส่งผลลัพธ์เป็น JSONB
        if (!data || data.ok !== true) {
          throw new Error(
            data?.message || "แลกของรางวัลไม่สำเร็จ"
          );
        }

        let message =
          "🎉 แลกของรางวัลสำเร็จ!\n" +
          `ใช้คะแนน ${data.cost} แต้ม`;

        if (data.remaining_points !== undefined) {
          message +=
            `\nคะแนนคงเหลือ ${data.remaining_points} แต้ม`;
        }

        if (data.remaining_stock !== undefined) {
          message +=
            `\nสินค้าคงเหลือ ${data.remaining_stock} ชิ้น`;
        }

        if (data.code) {
          message += `\nรหัสรับรางวัล: ${data.code}`;
        }

        alert(message);

        if (currentUserId === userId) {
          await loadMemberPoints(userId);
        }

        await loadRewards();

      } catch (error) {
        alert("แลกของรางวัลไม่สำเร็จ: " + error.message);
      } finally {
        button.disabled = false;
        button.textContent = "🎁 แลกของรางวัล";
      }
    }

    signupBtn.addEventListener("click", async () => {
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        memberStatus.textContent =
          "กรุณากรอกอีเมลและรหัสผ่าน";
        return;
      }

      signupBtn.disabled = true;
      loginBtn.disabled = true;
      memberStatus.textContent = "กำลังสมัครสมาชิก...";

      try {
        const { data, error } = await db.auth.signUp({
          email,
          password
        });

        if (error) throw error;

        if (data.session && data.user) {
          showMember("สมัครและเข้าสู่ระบบแล้ว", data.user);
          await loadMemberPoints(data.user.id);
        } else {
          memberStatus.textContent =
            "สมัครแล้ว กรุณาตรวจอีเมลเพื่อยืนยันบัญชี";
        }
      } catch (error) {
        memberStatus.textContent =
          "สมัครไม่สำเร็จ: " + error.message;
      } finally {
        signupBtn.disabled = false;
        loginBtn.disabled = false;
      }
    });

    loginBtn.addEventListener("click", async () => {
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        memberStatus.textContent =
          "กรุณากรอกอีเมลและรหัสผ่าน";
        return;
      }

      signupBtn.disabled = true;
      loginBtn.disabled = true;
      memberStatus.textContent = "กำลังเข้าสู่ระบบ...";

      try {
        const { data, error } = await db.auth.signInWithPassword({
          email,
          password
        });

        if (error) throw error;

        showMember("เข้าสู่ระบบแล้ว", data.user);
        await loadMemberPoints(data.user.id);
      } catch (error) {
        memberStatus.textContent =
          "เข้าสู่ระบบไม่สำเร็จ: " + error.message;
      } finally {
        signupBtn.disabled = false;
        loginBtn.disabled = false;
      }
    });

    logoutBtn.addEventListener("click", async () => {
      logoutBtn.disabled = true;
      menuStatus.textContent = "กำลังออกจากระบบ...";

      try {
        const { error } = await db.auth.signOut();

        if (error) throw error;

        showMember("ออกจากระบบแล้ว");
      } catch (error) {
        menuStatus.textContent =
          "ออกจากระบบไม่สำเร็จ: " + error.message;
      } finally {
        logoutBtn.disabled = false;
      }
    });

    async function restoreSession() {
      const { data, error } = await db.auth.getSession();

      if (error) {
        memberStatus.textContent =
          "ตรวจสอบสมาชิกไม่สำเร็จ: " + error.message;
        return;
      }

      if (data.session) {
        showMember("เข้าสู่ระบบแล้ว", data.session.user);
        await loadMemberPoints(data.session.user.id);
      } else {
        showMember("กรุณาเข้าสู่ระบบสมาชิก");
      }
    }

    db.auth.onAuthStateChange((event, session) => {
      if (event === "SIGNED_OUT") {
        showMember("ออกจากระบบแล้ว");
      } else if (event === "SIGNED_IN" && session?.user) {
        showMember("เข้าสู่ระบบแล้ว", session.user);
      }
    });

    loadRewards();
    restoreSession();
  </script>
</body>
</html>
